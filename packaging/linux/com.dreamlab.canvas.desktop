[Desktop Entry]
Type=Application
Name=DreamLab Canvas
GenericName=Image Editor
Comment=Edit photos and layered PSD documents
Exec=dreamlab-canvas %F
TryExec=dreamlab-canvas
Icon=com.dreamlab.canvas
Terminal=false
# The native runner does not complete desktop startup-notification handshakes.
StartupNotify=false
StartupWMClass=dreamlab-canvas
Categories=Graphics;2DGraphics;RasterGraphics;Photography;
Keywords=photo;image;editor;psd;layers;retouch;paint;
MimeType=application/x-dreamlab-canvas;image/x-paintnet;image/openraster;image/vnd.adobe.photoshop;image/x-psd;image/x-psb;image/png;image/jpeg;image/tiff;image/webp;image/gif;image/bmp;image/x-tga;image/x-icon;image/vnd.microsoft.icon;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-exr;image/vnd.radiance;image/avif;image/qoi;
