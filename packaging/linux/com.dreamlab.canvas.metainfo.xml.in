<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>com.dreamlab.canvas</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>DreamLab Canvas</name>
  <summary>Edit photos and layered PSD documents</summary>
  <developer id="com.dreamlab">
    <name>DreamLab</name>
  </developer>
  <description>
    <p>
      DreamLab Canvas is an open-source, native image editor with the familiar menus,
      shortcuts, panels and tools professionals expect: layers, masks, adjustment
      layers, layer styles, type and brushes.
    </p>
    <ul>
      <li>Open, edit and save layered PSD and PSB files</li>
      <li>8-bit, 16-bit and 32-bit float documents in RGB, grayscale, CMYK and Lab</li>
      <li>A GPU compositor with multithreaded filters</li>
      <li>Every action is a command, scriptable from a CLI, a JSON control channel and an MCP server</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.dreamlab.canvas.desktop</launchable>
  <icon type="stock">com.dreamlab.canvas</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/ADNY101/dreamlab-canvas</url>
  <url type="bugtracker">https://github.com/ADNY101/dreamlab-canvas/issues</url>
  <url type="help">https://github.com/ADNY101/dreamlab-canvas</url>
  <url type="contact">https://github.com/ADNY101/dreamlab-canvas/issues</url>
  <categories>
    <category>Graphics</category>
    <category>RasterGraphics</category>
    <category>Photography</category>
  </categories>
  <keywords>
    <keyword>photo</keyword>
    <keyword>image editor</keyword>
    <keyword>psd</keyword>
    <keyword>layers</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>Editing The Great Wave off Kanagawa with type layers and adjustment layers</caption>
      <image>https://raw.githubusercontent.com/ADNY101/dreamlab-canvas/main/docs/images/dreamlab-canvas-demo.jpg</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#9fd0ff</color>
    <color type="primary" scheme_preference="dark">#1f64ba</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>dreamlab-canvas</binary>
    <mediatype>application/x-dreamlab-canvas</mediatype>
    <mediatype>image/x-paintnet</mediatype>
    <mediatype>image/openraster</mediatype>
    <mediatype>image/vnd.adobe.photoshop</mediatype>
    <mediatype>image/x-psb</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
