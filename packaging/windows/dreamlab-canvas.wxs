<?xml version="1.0" encoding="utf-8"?>
<!--
  DreamLab Canvas MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2 WixToolset.Util.wixext/5.0.2`). Built by package.ps1:

    wix build dreamlab-canvas.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc dreamlab-canvas.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -d BannerBmp=... -d DialogBmp=... -o out.msi

  Per-machine install with a setup wizard that names the version: Welcome, install folder
  (Program Files\DreamLab Canvas by default, remembered for upgrades), Ready, a progress page, and a
  Finish page with a ticked "Launch DreamLab Canvas" box. Installs a Start Menu shortcut, makes
  DreamLab Canvas the owner of `.pcraft`, and offers it under "Open with" for PSD/PSB and the image
  formats it reads (without taking over the user's default app for them), plus dreamlab-canvas-cli.
  `msiexec /qn` still installs silently.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="DreamLab Canvas"
      Manufacturer="DreamLab"
      Version="$(var.Version)"
      UpgradeCode="C93AA682-4BCE-4C11-A1D2-67EC8BA59B66"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="DreamLab Canvas image editor" Manufacturer="DreamLab" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of DreamLab Canvas is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="DreamLabCanvasIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="DreamLabCanvasIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/ADNY101/dreamlab-canvas" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/ADNY101/dreamlab-canvas" />
    <Property Id="ARPHELPLINK" Value="https://github.com/ADNY101/dreamlab-canvas/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="DreamLab Canvas" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by DreamLabCanvasApp). -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\DreamLab Canvas" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="DreamLab Canvas" Level="1">
      <ComponentGroupRef Id="DreamLabCanvasFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchDreamLab Canvas"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through dreamlab-canvas.en-us.wxl. -->
    <Property Id="DreamLabCanvasVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="DreamLab Canvas $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch DreamLab Canvas" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#DreamLabCanvasExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchDreamLab Canvas" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="DreamLabCanvasFiles" Directory="INSTALLFOLDER">
      <Component Id="DreamLabCanvasApp" Guid="A290A611-E831-4D3A-A692-13574E801B79">
        <File Id="DreamLabCanvasExe" Source="$(var.BinDir)\dreamlab-canvas.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="DreamLab Canvas"
              Description="DreamLab Canvas image editor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="DreamLabCanvasIcon.exe" IconIndex="0" />
        </File>

        <!-- .pcraft: DreamLab Canvas's own format; DreamLab Canvas is its default app. -->
        <ProgId Id="DreamLabCanvas.Document" Description="DreamLab Canvas Document" Icon="DreamLabCanvasExe" IconIndex="0">
          <Extension Id="pcraft" ContentType="application/x-dreamlab-canvas">
            <Verb Id="open" Command="Open" TargetFile="DreamLabCanvasExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- PSD/PSB and images: offered under "Open with", never forced as the default. -->
        <ProgId Id="DreamLabCanvas.PhotoshopDocument" Description="PSD Document" Icon="DreamLabCanvasExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\DreamLabCanvas.PhotoshopDocument\shell\open\command" Value="&quot;[#DreamLabCanvasExe]&quot; &quot;%1&quot;" Type="string" />
        <ProgId Id="DreamLabCanvas.Image" Description="Image" Icon="DreamLabCanvasExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\DreamLabCanvas.Image\shell\open\command" Value="&quot;[#DreamLabCanvasExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.psd\OpenWithProgids" Name="DreamLabCanvas.PhotoshopDocument" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.psb\OpenWithProgids" Name="DreamLabCanvas.PhotoshopDocument" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pdn\OpenWithProgids" Name="DreamLabCanvas.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.ora\OpenWithProgids" Name="DreamLabCanvas.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.png\OpenWithProgids" Name="DreamLabCanvas.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.jpg\OpenWithProgids" Name="DreamLabCanvas.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.jpeg\OpenWithProgids" Name="DreamLabCanvas.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tif\OpenWithProgids" Name="DreamLabCanvas.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tiff\OpenWithProgids" Name="DreamLabCanvas.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.webp\OpenWithProgids" Name="DreamLabCanvas.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.gif\OpenWithProgids" Name="DreamLabCanvas.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.bmp\OpenWithProgids" Name="DreamLabCanvas.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tga\OpenWithProgids" Name="DreamLabCanvas.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.exr\OpenWithProgids" Name="DreamLabCanvas.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.hdr\OpenWithProgids" Name="DreamLabCanvas.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.avif\OpenWithProgids" Name="DreamLabCanvas.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.qoi\OpenWithProgids" Name="DreamLabCanvas.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.ico\OpenWithProgids" Name="DreamLabCanvas.Image" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "dreamlab-canvas"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\dreamlab-canvas.exe" Name="FriendlyAppName" Value="DreamLab Canvas" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\dreamlab-canvas.exe\shell\open\command" Value="&quot;[#DreamLabCanvasExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\dreamlab-canvas.exe\SupportedTypes" Name=".pcraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\dreamlab-canvas.exe\SupportedTypes" Name=".psd" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\dreamlab-canvas.exe\SupportedTypes" Name=".psb" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\dreamlab-canvas.exe\SupportedTypes" Name=".pdn" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\dreamlab-canvas.exe\SupportedTypes" Name=".ora" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\dreamlab-canvas.exe\SupportedTypes" Name=".png" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\dreamlab-canvas.exe\SupportedTypes" Name=".jpg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\dreamlab-canvas.exe\SupportedTypes" Name=".jpeg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\dreamlab-canvas.exe\SupportedTypes" Name=".tif" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\dreamlab-canvas.exe\SupportedTypes" Name=".tiff" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\dreamlab-canvas.exe\SupportedTypes" Name=".webp" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\dreamlab-canvas.exe\SupportedTypes" Name=".gif" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\dreamlab-canvas.exe\SupportedTypes" Name=".bmp" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\dreamlab-canvas.exe\SupportedTypes" Name=".tga" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\dreamlab-canvas.exe\SupportedTypes" Name=".exr" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\dreamlab-canvas.exe\SupportedTypes" Name=".hdr" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\dreamlab-canvas.exe\SupportedTypes" Name=".avif" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\dreamlab-canvas.exe\SupportedTypes" Name=".qoi" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\dreamlab-canvas.exe\SupportedTypes" Name=".ico" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\dreamlab-canvas.exe" Value="[#DreamLabCanvasExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\DreamLab Canvas" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="DreamLabCanvasCli">
        <File Id="DreamLabCanvasCliExe" Source="$(var.BinDir)\dreamlab-canvas-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
